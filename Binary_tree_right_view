def recRightView(root, level, maxLevel, result):
    if root is None:
        return

   
    if level > maxLevel[0]:
        result.append(root.data)
        maxLevel[0] = level

    recRightView(root.right, level + 1, 
                       maxLevel, result)
    recRightView(root.left, level + 1,
                       maxLevel, result)

def rightView(root):
    result = []
    maxLevel = [-1]
    
    recRightView(root, 0, maxLevel, result)
    
    return result
